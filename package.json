{
  "name": "ttrpg-generator",
  "version": "0.1.76",
  "description": "A TTRPG table generator engine with recursion support",
  "main": "server.js",
  "scripts": {
    "start": "npx tsc && npm run build:tables && node server.js",
    "build": "npx tsc && npm run build:tables",
    "build:tables": "npx ts-node src/compiler/build.ts",
    "lint:tables": "npx ts-node src/compiler/lint.ts",
    "cli": "npx ts-node scripts/cli.ts",
    "test": "vitest",
    "dev": "npm run build && nodemon server.js"
  },
  "author": {
    "name": "SeeJayMac"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^8.21.0",
    "js-yaml": "^4.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "eslintConfig": {},
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.1",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "zod": "^4.3.5"
  }
}